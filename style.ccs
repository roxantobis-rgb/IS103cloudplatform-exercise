* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: sans-serif;
}

body {
  background: #f5f5f5;
  padding: 20px;
}

h1 {
  text-align: center;
  color: #333;
  margin-bottom: 15px;
}

textarea {
  width: 100%;
  height: 350px;
  padding: 15px;
  border: none;
  border-radius: 8px;
  resize: vertical;
  font-size: 16px;
}

button {
  padding: 10px 20px;
  border: none;
  border-radius: 6px;
  font-size: 15px;
  cursor: pointer;
  margin: 10px 5px 0;
}

.save { background: #4CAF50; color: white; }
.dl   { background: #2196F3; color: white; }
.clear{ background: #ff9800; color: white; }
